{
  "name": "@fukicycle/design",
  "version": "0.3.0",
  "description": "fukicycle の全製品共通デザインシステム（凹凸とガラスの質感・アイコン・置き場所の決まり。色は製品ごと）",
  "license": "MIT",
  "author": "Fuki Sato (https://github.com/fukicycle)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fukicycle/design.git"
  },
  "type": "module",
  "bin": {
    "fk-contrast": "./scripts/check-contrast.mjs"
  },
  "files": [
    "tokens",
    "css",
    "icons",
    "scripts/check-contrast.mjs",
    "DESIGN.md",
    "LICENSE"
  ],
  "exports": {
    "./tokens.json": "./tokens/tokens.json",
    "./css/tokens.css": "./css/tokens.css",
    "./css/material.css": "./css/material.css",
    "./css/app.css": "./css/app.css",
    "./icons/icons.json": "./icons/icons.json",
    "./icons/line/*": "./icons/line/*",
    "./icons/glass/*": "./icons/glass/*",
    "./DESIGN.md": "./DESIGN.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-css.mjs"
  }
}
